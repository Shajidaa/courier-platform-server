<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password · Courier Platform</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        background: #eef2f6;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        padding: 20px;
        line-height: 1.5;
        color: #1e2b3c;
      }

      .email-card {
        max-width: 580px;
        width: 100%;
        background: #ffffff;
        border-radius: 24px;
        box-shadow:
          0 15px 35px -8px rgba(0, 20, 30, 0.15),
          0 4px 12px rgba(0, 0, 0, 0.05);
        overflow: hidden;
      }

      .accent-bar {
        height: 8px;
        background: linear-gradient(
          90deg,
          #e53e3e 0%,
          #dd6b20 45%,
          #d69e2e 100%
        );
        width: 100%;
      }

      .content {
        padding: 40px 40px 32px;
      }

      @media (max-width: 480px) {
        .content {
          padding: 28px 22px 24px;
        }
      }

      .brand-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 28px;
      }

      .brand-icon {
        background: #0b2b4a;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
        font-weight: 600;
        box-shadow: 0 6px 12px -4px rgba(11, 43, 74, 0.25);
      }

      .brand-text {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #0b2b4a;
        line-height: 1.2;
      }

      .brand-text span {
        display: block;
        font-size: 13px;
        font-weight: 400;
        color: #5e7a94;
        letter-spacing: 0.02em;
      }

      h1 {
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #0b2b4a;
        margin-bottom: 8px;
        line-height: 1.2;
      }

      .greeting {
        font-size: 16px;
        color: #2d4d6e;
        margin-bottom: 12px;
        font-weight: 500;
      }

      .message {
        font-size: 15px;
        color: #406078;
        margin-bottom: 28px;
        line-height: 1.6;
      }

      .message strong {
        color: #0b2b4a;
        font-weight: 600;
      }

      .otp-block {
        margin: 28px 0 24px;
        text-align: center;
      }

      .otp-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #5e7a94;
        margin-bottom: 10px;
      }

      .otp-code {
        display: inline-block;
        background: #fdf2f2;
        padding: 16px 28px;
        border-radius: 60px;
        font-size: 40px;
        font-weight: 700;
        letter-spacing: 10px;
        color: #c53030;
        font-family: "Inter", "Courier New", monospace;
        border: 1px solid #fed7d7;
        box-shadow: 0 4px 8px rgba(197, 48, 48, 0.06);
        word-break: break-word;
        line-height: 1.2;
      }

      @media (max-width: 480px) {
        .otp-code {
          font-size: 32px;
          letter-spacing: 6px;
          padding: 14px 20px;
        }
      }

      .expiry-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        color: #744210;
        background: #fffaf0;
        padding: 12px 18px;
        border-radius: 40px;
        margin: 24px 0 18px;
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
        border: 1px solid #feebc8;
      }

      .expiry-icon {
        font-size: 16px;
      }

      .expiry-note strong {
        font-weight: 700;
        color: #744210;
        margin: 0 2px;
      }

      .disclaimer {
        font-size: 14px;
        color: #6c879b;
        border-top: 1px solid #e4edf5;
        padding-top: 24px;
        margin-top: 10px;
        text-align: center;
        font-style: normal;
        line-height: 1.6;
      }

      .footer {
        background: #f7fbfe;
        padding: 22px 40px 20px;
        border-top: 1px solid #dae9f5;
        text-align: center;
        font-size: 12px;
        color: #5d7e9c;
        letter-spacing: 0.02em;
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 28px;
        margin-bottom: 12px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: #1d5b99;
        text-decoration: none;
        font-weight: 500;
        font-size: 12px;
      }

      .copyright {
        color: #7f99b2;
      }

      .separator {
        height: 1px;
        background: linear-gradient(90deg, transparent, #b6d2ea, transparent);
        margin: 6px 0 10px;
      }
    </style>
  </head>
  <body>
    <div class="email-card">
      <div class="accent-bar"></div>

      <div class="content">
        <div class="brand-header">
          <div class="brand-icon">📦</div>
          <div class="brand-text">Courier<span>Platform</span></div>
        </div>

        <h1>Reset your password</h1>

        <div class="greeting">Hello <strong><%= name %></strong>,</div>

        <div class="message">
          We received a request to reset the password for your Courier Platform account
          associated with <strong><%= email %></strong>. Use the code below to securely reset your password.
        </div>

        <div class="otp-block">
          <div class="otp-label">Password Reset Code</div>
          <div class="otp-code"><%= otp %></div>
        </div>

        <div class="expiry-note">
          <span class="expiry-icon">⏳</span>
          <span
            >Expires in <strong><%= expirationMinutes %></strong> minutes</span
          >
        </div>

        <div class="disclaimer">
          If you did not request a password reset, please ignore this email or contact support if you suspect unauthorized access.
        </div>
      </div>

      <div class="footer">
        <div class="footer-links">
          <a href="#">Help Center</a>
          <a href="#">Privacy</a>
          <a href="#">Terms</a>
        </div>
        <div class="separator"></div>
        <div class="copyright">
          &copy; Courier Platform System. All rights reserved.
        </div>
      </div>
    </div>
  </body>
</html>
